        float3 ri:limits:othreshold = (0.99609375, 0.99609375, 0.99609375)
        int ri:limits:pointmemory = 20480
        int ri:limits:ptexturemaxfiles = 128
        int ri:limits:ptexturememory = 32768
        float ri:limits:rendermemory = 0
        int ri:limits:rendertime = 0
        int ri:limits:texturememory = 2097150
        float ri:limits:textureperthreadmemoryratio = 0.5
        int ri:limits:threads = 0
        custom string ri:lpe:diffuse2 = "Diffuse,HairDiffuse,diffuse,translucent,hair4,irradiance"
        custom string ri:lpe:diffuse3 = "Subsurface,subsurface"
        custom string ri:lpe:specular2 = "Specular,HairSpecularR,specular,hair1"
        custom string ri:lpe:specular3 = "RoughSpecular,HairSpecularTRT,hair3"
