def Scope "materials"
{
    def Material "pxr_blue"
    {
        token outputs:ri:surface.connect = </materials/pxr_blue/pxrsurface1.outputs:bxdf_out>
        token outputs:surface.connect = </materials/pxr_blue/pxrsurface1_preview.outputs:surface>

        def Shader "pxrsurface1"
        {
            uniform token info:id = "PxrSurface"
            color3f inputs:diffuseColor = (0, 0, 1) (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.18, 0.18, 0.18)
                        string ogl_diff = "1"
                    }
                }
            )
            float inputs:diffuseGain (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            float inputs:glassIor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            color3f inputs:glowColor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:glowGain (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:specularFaceColor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0, 0, 0)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specularRoughness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            token outputs:bxdf_out
        }

        def Shader "pxrsurface1_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 0, 1)
            float inputs:roughness = 0.2
            token outputs:surface
        }
    }

    def Material "pxr_gray"
    {
        token outputs:ri:surface.connect = </materials/pxr_gray/pxrsurface1.outputs:bxdf_out>
        token outputs:surface.connect = </materials/pxr_gray/pxrsurface1_preview.outputs:surface>

        def Shader "pxrsurface1"
        {
            uniform token info:id = "PxrSurface"
            color3f inputs:diffuseColor = (0.6667, 0.6667, 0.6667) (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0.18, 0.18, 0.18)
                        string ogl_diff = "1"
                    }
                }
            )
            float inputs:diffuseGain (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1
                        string ogl_diff_intensity = "1"
                    }
                }
            )
            float inputs:glassIor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 1.5
                        string ogl_ior = "1"
                    }
                }
            )
            color3f inputs:glowColor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (1, 1, 1)
                        string ogl_emit = "1"
                    }
                }
            )
            float inputs:glowGain (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0
                        string ogl_emit_intensity = "1"
                    }
                }
            )
            color3f inputs:specularFaceColor (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double3 default_value = (0, 0, 0)
                        string ogl_spec = "1"
                    }
                }
            )
            float inputs:specularRoughness (
                customData = {
                    dictionary HoudiniPreviewTags = {
                        double default_value = 0.2
                        string ogl_rough = "1"
                    }
                }
            )
            token outputs:bxdf_out
        }

        def Shader "pxrsurface1_preview" (
            customData = {
                bool HoudiniIsAutoCreatedShader = 1
            }
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.6667, 0.6667, 0.6667)
            float inputs:roughness = 0.2
            token outputs:surface
        }
    }
